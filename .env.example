# ==============================================================================
# Karachi Bakery - Environment Configuration
# ==============================================================================

# MongoDB Atlas Connection URI
# 1. Sign up for free at https://www.mongodb.com/cloud/atlas
# 2. Create a Free Shared Cluster (M0) in AWS / Mumbai (ap-south-1)
# 3. Create a Database User (e.g., admin) and Password
# 4. Under Network Access, allow IP Access: 0.0.0.0/0 (required for Vercel Serverless)
# 5. Copy the connection string and paste below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/karachi_bakery?retryWrites=true&w=majority

# Optional: Set environment mode
NODE_ENV=production
